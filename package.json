{
  "name": "dragonwatch-extension",
  "version": "0.1.0",
  "private": true,
  "description": "DragonWatch cross-browser WebExtension for manual page annotation",
  "type": "module",
  "scripts": {
    "dev:firefox": "BROWSER_TARGET=firefox vite --mode development",
    "dev:chromium": "BROWSER_TARGET=chromium vite --mode development",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:chromium": "node scripts/build.mjs chromium",
    "build": "node scripts/build.mjs all",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "@types/webextension-polyfill": "^0.12.3",
    "eslint": "^9.13.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
